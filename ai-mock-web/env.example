# ================================
# AI Mock Interview - Environment Variables
# ================================
# Copy this file to .env.local and fill in the values

# ================================
# Authentication (NextAuth.js v5)
# ================================
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create a new project or select existing
# 2. Go to APIs & Services > Credentials
# 3. Create OAuth 2.0 Client ID
# 4. Add authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================
# Backend API
# ================================
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ================================
# Online Assessment question source (V2.1)
# ================================
# "mock"  — use the built-in mockAptitudeQuestions.ts (default, V1.1 behavior)
# "api"   — fetch a random question set from the FastAPI/Postgres question bank
NEXT_PUBLIC_ASSESSMENT_SOURCE=mock

# Server-only; must exactly match interview-backend INSTITUTION_PROXY_SECRET.
INSTITUTION_PROXY_SECRET=replace-with-a-long-random-secret
