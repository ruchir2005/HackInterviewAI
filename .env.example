# Copy this file to .env at the repo root to override docker-compose.yml's
# PostgreSQL defaults (below are the exact values docker-compose.yml already
# falls back to, so `docker compose up` works with no .env at all).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=interviews
POSTGRES_PORT=15432

# Shared server-to-server credential for institution APIs. Generate with:
# openssl rand -base64 32
INSTITUTION_PROXY_SECRET=
